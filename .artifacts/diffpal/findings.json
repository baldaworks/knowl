      "supporting_span": {
        "path": "pkg/knowl/store/sqlite/migrations/00014_maintenance_diagnostics.sql",
        "start_line": 2,
        "end_line": 2
      },
      "title": "Accept legacy empty diagnostics during SavePlan replay",
      "message": "The diagnostics migration defaults existing rows to an empty string, while EncodeMaintenanceDiagnostics(nil) produces \"[]\". Replaying SavePlan for a pre-migration operation already in StatusPlanned therefore returns ErrConflict even when the plan digest and diagnostics are unchanged.",
      "evidence": {
        "anchor": "pkg/knowl/store/sqlite/operations.go:169",
        "reasoning_basis": "The new StatusPlanned idempotency check requires the stored diagnostic payload to exactly equal the newly encoded payload. Existing rows migrated with maintenance_diagnostics='' cannot equal the canonical no-diagnostics payload '[]'; PostgreSQL has the same comparison.",
        "source": "changed_line"
      },
      "impact": {
        "summary": "Idempotent plan replay can fail for operations that were already planned before the diagnostics migration.",
        "scope": "Durable operation recovery and SavePlan callers for legacy SQLite and PostgreSQL rows."
      },
      "suggestion": "Treat an empty stored payload as equivalent to the canonical empty array during the idempotency check in both backends, or canonicalize legacy rows during migration.",
      "blocking": false,
      "provider": "codex-acp"
    }
  ]
